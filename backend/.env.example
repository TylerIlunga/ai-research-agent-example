# Server Configuration
NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=1

# Security Configuration
# In development these are generated in memory if unset; in production they are required.
JWT_SECRET=your_jwt_secret_here_min_64_chars_replace_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_min_64_chars_replace_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Key Management
MASTER_ENCRYPTION_KEY=your_master_encryption_key_here_min_64_chars
KEY_DERIVATION_SALT=your_key_derivation_salt_here_min_64_chars
REQUEST_SIGNING_SECRET=your_request_signing_secret_here_min_64_chars

# Rate Limiting & Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
BLOCKED_COUNTRIES=
BLOCKED_IPS=
ALLOW_PRIVATE_IPS=true
STRICT_IP_VALIDATION=false
BLOCK_AUTOMATED_CLIENTS=false

# ---------------------------------------------------------------------------
# Model provider chain. `auto` takes the first one it can actually use, so a
# missing key costs quality rather than availability.
#   1. anthropic    - Claude Opus 5. What the prompts are written for.
#   2. openai       - Any OpenAI-compatible endpoint, including local models.
#   3. claude-code  - The local Claude Code CLI. No API key at all, but ~$0.15
#                     and ~5s of process startup per call.
# Set to a specific name to pin it instead.
MODEL_PROVIDER=auto
MODEL_MAX_RETRIES=2

# How the research phase gathers evidence.
#   auto    - agentic when the provider supports tool calling, direct otherwise
#   agentic - the model drives its own search loop
#   direct  - each planned sub-question is searched directly (no tool calling,
#             two model calls per run; works with local and CLI providers)
RESEARCH_MODE=auto

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Any of these work unchanged — all three take the same request shape
# (adaptive thinking + output_config.effort, no sampling parameters):
#   claude-fable-5   $10 / $50 per MTok - deepest reasoning; needs 30-day retention
#   claude-opus-5    $5  / $25 per MTok - what the prompts were written against
#   claude-sonnet-5  $2  / $10 per MTok - cheapest sensible default for local dev
ANTHROPIC_MODEL=claude-opus-5

# Failover 1 - OpenAI, or anything that speaks its API:
#   OPENAI_BASE_URL=http://localhost:11434/v1  with  OPENAI_MODEL=llama3.1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
OPENAI_MAX_OUTPUT_TOKENS=8192

# Failover 2 - the Claude Code CLI, if it is installed and logged in.
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=opus

# ---------------------------------------------------------------------------
# Search provider chain, same idea. Without any of these the agent answers
# from model knowledge and says so.
#   1. tavily   - the only one that returns full page text to summarize
#   2. brave    - independent index, 2,000 free queries/month
#   3. searxng  - keyless; point at a SearXNG instance you run (JSON enabled)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=your_tavily_api_key_here
# BRAVE_API_KEY=
# SEARXNG_URL=http://localhost:8080
SEARCH_BUDGET=5
RESULTS_PER_SEARCH=4

# Allow keys to be supplied at runtime through the UI (POST /api/agent/config).
# Held in memory only, never written to disk. Defaults to on in development
# and off everywhere else.
# ALLOW_RUNTIME_KEYS=true

# Long-term memory (optional) - needs Pinecone AND OpenAI. The same
# OPENAI_API_KEY powers both embeddings and the failover provider above;
# Anthropic has no embeddings endpoint. Research works without memory.
OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name
PINECONE_INDEX_NAMESPACE=research-agent
EMBEDDING_MODEL=text-embedding-3-small
# Set only if your Pinecone index has a fixed dimension to match
# EMBEDDING_DIMENSIONS=1536

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_SECURITY_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Production Security Settings (only in production)
# HTTPS_CERT_PATH=/path/to/ssl/cert.pem
# HTTPS_KEY_PATH=/path/to/ssl/key.pem
# ENABLE_HSTS=true
# ENABLE_CSP_REPORTING=true
# CSP_REPORT_URI=https://your-csp-report-endpoint.com

# Rate Limiting Overrides (optional)
# GLOBAL_RATE_LIMIT_PER_HOUR=1000
# IP_RATE_LIMIT_PER_HOUR=100
# USER_RATE_LIMIT_PER_HOUR=50
# RESEARCH_RATE_LIMIT_PER_HOUR=20